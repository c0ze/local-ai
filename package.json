{
  "name": "local-ai-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "scripts/deploy_cloudflare.sh",
    "mcp:bridge": "node scripts/mcp-bridge.mjs",
    "test:models:install": "playwright install chromium",
    "test:models": "playwright test tests/model-compatibility.spec.ts --reporter=line",
    "test:models:all": "MODEL_TEST_DTYPES=all playwright test tests/model-compatibility.spec.ts --reporter=line"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "highlight.js": "^11.10.0",
    "kokoro-js": "^1.2.1",
    "marked": "^15.0.0",
    "zod": "^4.4.2"
  }
}
